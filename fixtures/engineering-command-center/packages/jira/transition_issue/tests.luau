local dash = require("dash")
local Runtime = require("runtime")

dash.test("dry_run targets a done status by default", function(make_ctx)
    local ctx = make_ctx({ args = { key = "DEV-123" } })
    local res = Runtime.dry_run(ctx)
    dash.assert(res.feasible == true, "expected feasible")
    dash.assert_eq(res.effects.target_category, "done", "default target is the done category")
    dash.assert_eq(res.effects.target_status, "Done", "the workflow's done status")
    dash.assert_eq(res.effects.from_status, "In Review", "current status")
    dash.assert_eq(res.effects.transition, "Done", "workflow transition used")
end)

dash.test("execute moves the issue through the Mock workflow; repeating is a no-op", function(make_ctx)
    local ctx = make_ctx({ args = { key = "DEV-123", status = "Done", comment = "Merged" } })
    local res = Runtime.execute(ctx)
    dash.assert_eq(res, { key = "DEV-123", status = "Done", transitioned = true }, "transitioned")
    local again = Runtime.execute(ctx)
    dash.assert(again.transitioned == false, "idempotent")
    dash.assert_eq(Runtime.reconcile(ctx).status, "succeeded", "reconcile observes Done")
end)

dash.test("a status the workflow cannot reach is infeasible and fails definitively", function(make_ctx)
    local ctx = make_ctx({ args = { key = "DEV-130", status = "In Review" } })
    local rep = Runtime.dry_run(ctx)
    dash.assert(rep.feasible == false, "To Do cannot go straight to In Review")
    dash.assert(string.find(rep.warnings[1], "Start Progress", 1, true) ~= nil, rep.warnings[1])
    local ok, err = pcall(Runtime.execute, ctx)
    dash.assert(not ok and string.find(tostring(err), "NO_TRANSITION", 1, true) ~= nil, tostring(err))
    dash.assert_eq(Runtime.reconcile(ctx).status, "failed", "still To Do")
end)

dash.test("a status category target moves through the workflow and is idempotent", function(make_ctx)
    local ctx = make_ctx({ args = { key = "DEV-130", status_category = "in_progress" } })
    local res = Runtime.execute(ctx)
    dash.assert_eq(res, { key = "DEV-130", status = "In Progress", transitioned = true }, "first in-progress status")
    dash.assert(Runtime.execute(ctx).transitioned == false, "already in progress")
    dash.assert_eq(Runtime.reconcile(ctx).status, "succeeded", "reconcile by category")
end)
