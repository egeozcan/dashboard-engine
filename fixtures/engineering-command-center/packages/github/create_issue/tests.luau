local dash = require("dash")
local Runtime = require("runtime")

dash.test("dry_run validates without creating anything", function(make_ctx)
    local bad = Runtime.dry_run(make_ctx({ args = { repository = "not a repo", title = " " } }))
    dash.assert(bad.feasible == false, "invalid args are infeasible")
    dash.assert_eq(#bad.warnings, 2, "both problems reported")
    local good = Runtime.dry_run(make_ctx({ args = { repository = "acme/platform", title = "Broken build" } }))
    dash.assert(good.feasible == true, "valid args")
end)

dash.test("execute creates the issue through the github Mock", function(make_ctx)
    local ctx = make_ctx({ args = { repository = "acme/platform", title = "Broken build", labels = { "bug" } } })
    local res = Runtime.execute(ctx)
    dash.assert_eq(res.number, 1000, "next Mock issue number")
    dash.assert_eq(res.id, "acme/platform#1000", "stable id")
    local second = Runtime.execute(make_ctx({ args = { repository = "acme/platform", title = "Another" } }))
    dash.assert_eq(second.number, 1001, "Mock state persists within a test")
    local ok, err = pcall(function()
        return ctx:await(ctx.inputs.github:call("get_issue", { repository = "acme/platform", number = 1000 }))
    end)
    dash.assert(not ok and string.find(tostring(err), "issues.read", 1, true) ~= nil, "the write-only input cannot read: " .. tostring(err))
end)
