local dash = require("dash")
local Runtime = require("runtime")

dash.test("aggregates statuses and check runs into one CI state", function(make_ctx)
    local green = Runtime.query(make_ctx({ query = { repository = "acme/platform", ref = "feat/query-dedup" } }))
    dash.assert_eq(green.state, "success", "all checks passed")
    dash.assert_eq(green.total, 3, "one status and two check runs")
    local red = Runtime.query(make_ctx({ query = { repository = "acme/platform", ref = "7b3d9a1c43" } }))
    dash.assert_eq(red.state, "failure", "a failing check run fails the ref")
    dash.assert_eq(red.failure, 1, "one failure")
    local running = Runtime.query(make_ctx({ query = { repository = "acme/platform", ref = "main" } }))
    dash.assert_eq(running.state, "pending", "in-progress checks")
    local skipped = Runtime.query(make_ctx({ query = { repository = "acme/payments", ref = "fix/idempotency" } }))
    dash.assert_eq(skipped.state, "success", "skipped checks are neutral")
    dash.assert_eq(skipped.neutral, 1, "one neutral")
end)
